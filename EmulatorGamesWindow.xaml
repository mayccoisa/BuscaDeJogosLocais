<UserControl x:Class="BuscaDeJogosLocais.EmulatorGamesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">

    <!--
        A gêmea da FolderGamesWindow, do lado da emulação. As duas respondem à mesma pergunta
        ("o que dessa pasta já virou biblioteca?") e por isso se parecem de propósito: quem
        aprendeu a ler uma não precisa aprender a outra.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="20,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TitleBar}" />
                    <Image Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                           Source="{Binding Icone}"
                           Visibility="{Binding TemIcone, Converter={StaticResource BoolToVisible}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding HeaderText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageDescription}" Margin="18,8,0,0" Text="{Binding ResumoText}" />
                <TextBlock Style="{StaticResource HintText}" Margin="18,4,0,0" TextWrapping="Wrap"
                           Text="{Binding PastasText}" />
            </StackPanel>

            <CheckBox Grid.Row="1" Margin="0,0,0,10"
                      Content="Mostrar só o que ficou de fora" IsChecked="{Binding SomenteForaDaBiblioteca}" />

            <DataGrid Grid.Row="2" Style="{StaticResource ThemedDataGrid}"
                      ItemsSource="{Binding ItensView}" IsReadOnly="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Jogo" Binding="{Binding Nome}" Width="*" MinWidth="200" />

                    <DataGridTemplateColumn Header="Situação" Width="150" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Console" Binding="{Binding Plataforma}" Width="150" />

                    <DataGridTemplateColumn Header="Arquivo" Width="260" SortMemberPath="Arquivo">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PathText}" Text="{Binding Arquivo}" ToolTip="{Binding Caminho}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Margin="0"
                            Content="Abrir pasta no Explorador" Click="OnAbrirPastaClick"
                            Visibility="{Binding PodeAbrirPasta, Converter={StaticResource BoolToVisible}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0"
                            Content="Fechar" Click="OnFecharClick" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
