<UserControl x:Class="BuscaDeJogosLocais.ConsoleLibraryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="20,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TitleBar}" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding HeaderText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageDescription}" Margin="18,8,0,0"
                           Text="A biblioteca (Fonte) passa a ser o console lido do emulador que cada jogo referencia. O nome é editável na tabela, e nada é gravado até você aplicar." />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
                <TextBlock Style="{StaticResource HintText}" Margin="0" Text="{Binding ResumoTexto}" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Style="{StaticResource GhostButton}" Content="Marcar todos" Click="OnMarcarTodosClick" />
                <Button Style="{StaticResource GhostButton}" Content="Desmarcar todos" Click="OnDesmarcarTodosClick" Margin="0,0,20,0" />
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding ContagemTexto}" />
            </StackPanel>

            <DataGrid x:Name="GridBibliotecas" Grid.Row="3" Style="{StaticResource ThemedDataGrid}"
                      ItemsSource="{Binding Itens}" SelectionMode="Extended"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center" Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Jogo" Binding="{Binding NomeJogo}" Width="2*" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Emulador" Width="140" SortMemberPath="Emulador">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PathText}" Text="{Binding Emulador}" ToolTip="{Binding Emulador}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Biblioteca atual" Width="140" SortMemberPath="BibliotecaAtual">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PathText}"
                                           Text="{Binding BibliotecaAtual, Converter={StaticResource TextOrDash}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Biblioteca (console)" Binding="{Binding BibliotecaNova, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Lido de" Width="140" SortMemberPath="Origem">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PathText}" Text="{Binding Origem}" ToolTip="{Binding Origem}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Situação" Width="180" SortMemberPath="Situacao">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Situacao}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
                <Grid>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0"
                            Content="Cancelar" Click="OnFecharClick" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0"
                            Content="Aplicar selecionados" Click="OnAplicarClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
