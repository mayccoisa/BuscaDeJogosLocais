<UserControl x:Class="BuscaDeJogosLocais.ConsoleLibraryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BuscaDeJogosLocais"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Cabecalho/celulas seguindo o tema do Playnite (o padrao do WPF fica ilegivel no escuro). -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding HeaderText}" FontSize="14" FontWeight="Bold" Foreground="Gold" />
            <TextBlock Text="A biblioteca (Fonte) passa a ser o console lido do emulador que cada jogo referencia. Você pode editar o nome direto na tabela — nada é gravado até clicar em Aplicar."
                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Resumo por console -->
        <Border Grid.Row="1" Background="#11FFFFFF" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding ResumoTexto}" TextWrapping="Wrap" Opacity="0.85" FontSize="12"
                       Foreground="{DynamicResource TextBrush}" />
        </Border>

        <!-- Seleção -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Marcar todos" Click="OnMarcarTodosClick" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Desmarcar todos" Click="OnDesmarcarTodosClick" Padding="10,4" Margin="0,0,20,0" Cursor="Hand" />
            <TextBlock Text="{Binding ContagemTexto}" VerticalAlignment="Center" Opacity="0.7" FontSize="11" />
        </StackPanel>

        <DataGrid x:Name="GridBibliotecas" Grid.Row="3"
                  ItemsSource="{Binding Itens}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="#22FFFFFF"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#11FFFFFF"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#22FFFFFF"
                  HeadersVisibility="Column"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Aplicar" Width="65" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Jogo" Binding="{Binding NomeJogo}" Width="2*" IsReadOnly="True" />

                <DataGridTextColumn Header="Emulador" Binding="{Binding Emulador}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.7" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Biblioteca atual" Binding="{Binding BibliotecaAtual}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Biblioteca (console)" Binding="{Binding BibliotecaNova, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="LightGreen" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Lido de" Binding="{Binding Origem}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.7" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="170" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.8" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✅ APLICAR SELECIONADOS" Click="OnAplicarClick"
                    Padding="15,7" Margin="0,0,10,0" Cursor="Hand" />
            <Button Content="Cancelar" Click="OnFecharClick" Padding="15,7" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
