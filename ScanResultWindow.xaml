<UserControl x:Class="BuscaDeJogosLocais.ScanResultWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="20,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TitleBar}" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding HeaderText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageDescription}" Margin="18,8,0,0"
                           Text="Marque o que quer importar. Nome e versão podem ser corrigidos aqui na tabela antes de gravar." />
            </StackPanel>

            <!-- Pastas que mudaram de lugar: aparecem antes da tabela porque a ação certa nelas
                 é reapontar, e importar criaria o mesmo jogo duas vezes na biblioteca. -->
            <Border Grid.Row="1" Style="{StaticResource OkBanner}"
                    Visibility="{Binding QuantosMudaramDePasta, Converter={StaticResource CountToVisible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource BannerGlyph}"
                            Background="#2A70D89B" BorderBrush="#A870D89B">
                        <TextBlock Style="{StaticResource BannerGlyphText}" Foreground="{StaticResource GreenBrush}" Text="→" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BannerTitle}" Text="{Binding TituloMudaramDePasta}" />
                        <TextBlock Style="{StaticResource BannerText}"
                                   Text="Estas pastas já são jogos da sua biblioteca que mudaram de lugar ou de nome. Reapontar mantém o registro com o tempo de jogo, as capas e as tags." />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource BannerButton}"
                            Content="Reapontar" Click="OnReapontarClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="Ocultar o que já está na biblioteca" IsChecked="{Binding OcultarJaExistentes}"
                          VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding ContagemTexto}" />
            </StackPanel>

            <DataGrid x:Name="GridResultados" Grid.Row="3" Style="{StaticResource ThemedDataGrid}"
                      ItemsSource="{Binding ResultadosView}" SelectionMode="Extended"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          IsEnabled="{Binding JaExiste, Converter={StaticResource InverseBoolean}}"
                                          HorizontalAlignment="Center" Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Jogo" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding NomeOriginal}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Versão" Binding="{Binding Versao, UpdateSourceTrigger=PropertyChanged}" Width="110" />

                    <DataGridTemplateColumn Header="Situação" Width="150" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Pasta" Width="260" SortMemberPath="PastaRaiz">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource PathText}" Text="{Binding PastaRaiz}" ToolTip="{Binding PastaRaiz}" />
                                    <TextBlock Style="{StaticResource PathText}" Margin="0,2,0,0"
                                               Text="{Binding MovidoDePasta, StringFormat=antes em {0}}"
                                               ToolTip="{Binding MotivoMudanca}"
                                               Visibility="{Binding EhMudancaDePasta, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CellButton}" Content="Ignorar"
                                        ToolTip="Não mostrar esta pasta em buscas futuras"
                                        Tag="{Binding}" Click="OnIgnorarClick" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
                <Grid>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0"
                            Content="Fechar" Click="OnFecharClick" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0"
                            Content="Importar selecionados" Click="OnImportarClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
