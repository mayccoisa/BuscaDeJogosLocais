<UserControl x:Class="BuscaDeJogosLocais.BuscaDeJogosLocaisSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:BuscaDeJogosLocais.Ui"
             mc:Ignorable="d"
             MinWidth="900" MinHeight="580"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             d:DesignHeight="600" d:DesignWidth="1000">

    <!--
        Esta tela era um TabControl de nove abas com 726 linhas de XAML num arquivo só, e as
        configurações moravam dentro da aba "Pastas Monitoradas" — foi lá que as caixas de
        opção comeram a altura da tabela e ela sumiu com zero pixel. Agora cada aba é uma
        página própria em Ui/, o ajuste tem aba própria, e as quatro abas que eram só
        histórico viraram uma só, com abas laterais.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <TabControl x:Name="Tabs"
                    Style="{StaticResource TopTabControl}"
                    ItemContainerStyle="{StaticResource TopTabItem}">

            <TabItem Header="Início">
                <ui:InicioPage />
            </TabItem>

            <TabItem Header="Busca e importação">
                <ui:BuscaPage />
            </TabItem>

            <TabItem Header="Pastas monitoradas">
                <ui:PastasPage />
            </TabItem>

            <TabItem Header="Jogos que sumiram">
                <ui:ReparoPage />
            </TabItem>

            <TabItem Header="Duplicados">
                <ui:DuplicadosPage />
            </TabItem>

            <TabItem Header="Histórico">
                <ui:HistoricoPage />
            </TabItem>

            <TabItem Header="Ajustes">
                <ui:AjustesPage />
            </TabItem>

            <TabItem Header="Atualizações">
                <ui:AtualizacoesPage />
            </TabItem>

        </TabControl>
    </Border>
</UserControl>
