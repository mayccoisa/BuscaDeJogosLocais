<UserControl x:Class="BuscaDeJogosLocais.BuscaDeJogosLocaisSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BuscaDeJogosLocais"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <local:GroupCountConverter x:Key="GroupCountConverter" />

        <!-- O DataGrid do WPF traz cabeçalho claro com texto escuro, que fica ilegível sobre o
             tema escuro do Playnite. Estes estilos implícitos valem para todas as grades da tela
             e puxam a cor do tema em uso (TextBrush), em vez de cor fixa. -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- ESTILO PARA AGRUPAMENTO NO DATAGRID -->
        <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="#11FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,5">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 Origem: " FontWeight="Bold" Opacity="0.7" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="Gold" />
                                    <TextBlock Opacity="0.6" Margin="5,0,0,0" Foreground="{DynamicResource TextBrush}"
                                               ToolTip="Jogos desta pasta na biblioteca / total de pastas encontradas no disco">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource GroupCountConverter}">
                                                <Binding Path="Name" />
                                                <Binding Path="ItemCount" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- ABA 1: CONFIGURAÇÕES E MONITORAMENTO -->
            <TabItem Header="Pastas Monitoradas">
                <!-- Sem o ScrollViewer, as caixas de cima comem a altura e a grade de pastas
                     fica com zero pixel — some da tela sem nenhum aviso. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Configurações de Identificação" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="Gold" />
                            <CheckBox Content="Identificar o HD (ex: 'HD D:') como Característica ao importar" 
                                      IsChecked="{Binding Settings.TagDriveAsFeature}" 
                                      VerticalContentAlignment="Center" Margin="0,5,0,5" />
                            <TextBlock Text="Adiciona automaticamente a letra do disco aos jogos para facilitar filtros." 
                                       FontStyle="Italic" Opacity="0.7" Margin="25,0,0,10" FontSize="11" />
                            <Button Content="🚀 Aplicar Tags de HD nos Jogos Já Importados"
                                    Command="{Binding UpdateExistingGamesDriveCommand}"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="25,5,0,0" Cursor="Hand" />

                            <TextBlock Text="Marca os jogos como Fonte 'Local' para exibição e filtros nativos do Playnite."
                                       FontStyle="Italic" Opacity="0.7" Margin="25,12,0,5" FontSize="11" />
                            <Button Content="📍 Marcar Jogos Já Importados como Fonte 'Local'"
                                    Command="{Binding ApplyLocalSourceToExistingCommand}"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="25,0,0,0" Cursor="Hand" />

                            <TextBlock Text="Jogos de emulação: biblioteca por console"
                                       FontSize="14" FontWeight="Bold" Foreground="Gold" Margin="0,18,0,6" />
                            <TextBlock TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7" Margin="25,0,0,8" FontSize="11"
                                       Text="Jogo de emulação entra na biblioteca sem Fonte nenhuma e some dentro do balde 'local'. Aqui a extensão lê o emulador (e o perfil) que cada jogo referencia e usa o console como Fonte: PlayStation 2, Nintendo Switch, Game Boy Advance. É o que faz a tela de perfil do tema mostrar onde seus jogos estão concentrados. Você confere e edita numa prévia antes de gravar." />
                            <Button Content="🎮 Completar Biblioteca dos Jogos de Emulação"
                                    Command="{Binding CompletarBibliotecaCommand}"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="25,0,0,0" Cursor="Hand" />

                            <TextBlock Text="Nome e versão" FontSize="14" FontWeight="Bold" Foreground="Gold" Margin="0,18,0,6" />
                            <CheckBox Content="Limpar o nome da pasta ao importar"
                                      IsChecked="{Binding Settings.LimparNomeDaPasta}"
                                      VerticalContentAlignment="Center" Margin="0,5,0,5" />
                            <TextBlock Text="Remove versão, grupo de release e ruído do nome da pasta. Ex.: &quot;STARDUST.Wish.of.Witch.v20260729-P2P&quot; vira &quot;STARDUST Wish of Witch&quot;. O nome fica editável na tela de resultados antes de importar."
                                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7" Margin="25,0,0,10" FontSize="11" />
                            <CheckBox Content="Guardar a versão detectada no campo 'Versão' do jogo"
                                      IsChecked="{Binding Settings.GuardarVersaoDetectada}"
                                      VerticalContentAlignment="Center" Margin="0,5,0,5" />
                            <TextBlock Text="A versão que estava no nome da pasta (v1.00.1, Build 12345, Update 3) não se perde: vai para o campo nativo de versão do Playnite."
                                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7" Margin="25,0,0,10" FontSize="11" />
                            <Button Content="🧹 Limpar Nomes dos Jogos Já Importados"
                                    Command="{Binding LimparNomesExistentesCommand}"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="25,0,0,0" Cursor="Hand" />

                            <TextBlock Text="Metadados" FontSize="14" FontWeight="Bold" Foreground="Gold" Margin="0,18,0,6" />
                            <CheckBox Content="Baixar metadados dos jogos logo após importar"
                                      IsChecked="{Binding Settings.BaixarMetadadosAposImportar}"
                                      VerticalContentAlignment="Center" Margin="0,5,0,5" />
                            <TextBlock Text="Ao terminar a importação, busca capa, ícone, fundo, descrição, gêneros e data de lançamento nas fontes de metadados instaladas no Playnite (IGDB, Xbox Metadata...). Campos já preenchidos nunca são sobrescritos."
                                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7" Margin="25,0,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- SCAN AUTOMÁTICO -->
                    <Border Grid.Row="1" Background="#11FFFFFF" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Scan Automático" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10" />
                            <CheckBox Content="Escanear automaticamente ao iniciar o Playnite"
                                      IsChecked="{Binding Settings.EscanearAutomaticamente}"
                                      VerticalContentAlignment="Center" Margin="0,5,0,5" />
                            <StackPanel Orientation="Horizontal" Margin="25,5,0,5"
                                        IsEnabled="{Binding Settings.EscanearAutomaticamente}">
                                <TextBlock Text="Intervalo entre scans (dias):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="50" Text="{Binding Settings.IntervaloScanDias, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UltimoScanTexto}" FontStyle="Italic" Opacity="0.7" Margin="25,3,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Gerencie as pastas que o plugin deve vigiar:" FontWeight="Bold" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕ Adicionar Nova Pasta" Command="{Binding AddFolderCommand}" Padding="10,5" Margin="0,0,8,0" />
                            <Button Content="🔄 Atualizar resumo" Command="{Binding AtualizarResumoPastasCommand}" Padding="10,5" />
                        </StackPanel>
                        <TextBlock Text="Cada linha mostra quanto daquela pasta já virou jogo na biblioteca. Clique em 'Ver jogos' para a lista completa, incluindo o que ficou de fora."
                                   TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding PastasResumo}" Height="280"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#22FFFFFF" RowBackground="Transparent" AlternatingRowBackground="#11FFFFFF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#22FFFFFF"
                              HeadersVisibility="Column" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pasta" Binding="{Binding Caminho}" Width="*" />

                            <DataGridTextColumn Header="Situação" Binding="{Binding StatusTexto}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Tudo importado">
                                                <Setter Property="Foreground" Value="LightGreen" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Nada importado">
                                                <Setter Property="Foreground" Value="#FF8080" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Parcialmente importado">
                                                <Setter Property="Foreground" Value="Gold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTexto}" Value="Pasta inacessível">
                                                <Setter Property="Foreground" Value="#FF8080" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Na biblioteca" Binding="{Binding NaBiblioteca}" Width="100" />
                            <DataGridTextColumn Header="Fora" Binding="{Binding NaoImportados}" Width="70" />
                            <DataGridTextColumn Header="Com problema" Binding="{Binding ComProblema}" Width="110" />
                            <DataGridTextColumn Header="Ignorados" Binding="{Binding Ignorados}" Width="90" />

                            <DataGridTemplateColumn Header="" Width="100" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ver jogos"
                                                Command="{Binding DataContext.VerJogosDaPastaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- O resumo em texto virou a grade acima; ficou só o total, numa linha. -->
                    <TextBlock Grid.Row="4" Text="{Binding PastasResumoTexto}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.7" FontSize="11" Margin="0,4,0,0" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 2: DESCOBERTA E IMPORTAÇÃO -->
            <TabItem Header="Busca e Importação">
                <Grid Margin="10,20,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BARRA DE FILTROS -->
                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filtros:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" />
                            
                            <ComboBox ItemsSource="{Binding OpcoesPastas}" SelectedValue="{Binding FiltroPastaSelecionada}" Width="200" VerticalAlignment="Center" />
                            
                            <CheckBox Content="Ocultar jogos já importados" IsChecked="{Binding FiltrarApenasNovos}" VerticalAlignment="Center" Margin="20,0,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{Binding ScanButtonLabel}" Command="{Binding ScanNowCommand}" Padding="15,8" FontWeight="Bold" />
                        <TextBlock Text="{Binding ScanHintText}" VerticalAlignment="Center" Margin="15,0,0,0" Opacity="0.7"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="A lista abre com os jogos que já estão na biblioteca; escaneie para procurar novidades no disco."
                                   VerticalAlignment="Center" Margin="15,0,0,0" Opacity="0.6" FontStyle="Italic" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid ItemsSource="{Binding JogosEncontradosView}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                  Background="#11FFFFFF" BorderThickness="1"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  CanUserResizeColumns="True" CanUserReorderColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  ColumnWidth="SizeToCells">
                            <DataGrid.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Sel." Width="60" MinWidth="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="2"
                                                    Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding JaExiste, Converter={StaticResource InverseBooleanConverter}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Nome do Jogo" Width="400" MinWidth="300" SortMemberPath="Nome">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="5,4"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Status" Width="200" MinWidth="180" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="5,4"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Última verificação" Width="150" MinWidth="130" SortMemberPath="UltimaVerificacao">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UltimaVerificacao}" VerticalAlignment="Center" Margin="5,4"
                                                       Foreground="{DynamicResource TextBrush}" Opacity="0.8"
                                                       ToolTip="Data do último scan que confirmou esta pasta no disco" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Pasta Raiz" Width="600" MinWidth="400" SortMemberPath="PastaRaiz">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PastaRaiz}" VerticalAlignment="Center" Margin="5,2"
                                                       Foreground="{DynamicResource TextBrush}" Opacity="0.8"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PastaRaiz}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="🛒 IMPORTAR SELECIONADOS" Command="{Binding ImportSelectedCommand}" Margin="0,10,0,0" Padding="20,10" FontWeight="Bold" Background="#2200FF00" HorizontalAlignment="Right" />
                </Grid>
            </TabItem>

            <!-- ABA 3: HISTÓRICO -->
            <TabItem Header="Histórico de Importação">
                <Grid Margin="10,20,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BARRA DE FILTROS HISTÓRICO -->
                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ver Origem:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding OpcoesPastas}" SelectedValue="{Binding FiltroPastaSelecionada}" Width="200" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoricoView}" 
                              AutoGenerateColumns="False" IsReadOnly="True" Background="#11FFFFFF"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              CanUserResizeColumns="True" CanUserReorderColumns="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Data" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataImportacao}" Foreground="{DynamicResource TextBrush}" Margin="5,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Jogo" Width="*" SortMemberPath="NomeJogo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NomeJogo}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" Margin="5,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Local de Origem" Width="2*" SortMemberPath="Origem">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Origem}" Foreground="{DynamicResource TextBrush}" Opacity="0.8" Margin="5,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="Limpar Histórico" Command="{Binding ClearHistoryCommand}" Margin="0,10,0,0" HorizontalAlignment="Right" />
                </Grid>
            </TabItem>
            <!-- ABA 4: REPARAR DESINSTALADOS -->
            <TabItem Header="Reparar Desinstalados">
                <Grid Margin="10,20,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock Text="Localize jogos que mudaram de pasta ou cujo executável sumiu. O plugin tentará encontrar o novo local usando as Pastas Monitoradas. Jogos que não forem encontrados em nenhuma pasta podem ser marcados como desinstalados." TextWrapping="Wrap" Opacity="0.8" />
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔍 PROCURAR CAMINHOS" Command="{Binding SearchLostGamesCommand}" Padding="15,8" FontWeight="Bold" />
                        <TextBlock Text="Verifica jogos não instalados (ou com executável ausente) e procura seus executáveis." VerticalAlignment="Center" Margin="15,0,0,0" Opacity="0.7" />
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding JogosParaRelinkarView}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" 
                              Background="#11FFFFFF" BorderThickness="1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              CanUserResizeColumns="True" CanUserReorderColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sel." Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="2" 
                                                Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Nome do Jogo" Width="2*" MinWidth="150" SortMemberPath="Nome">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="5,4" 
                                                   Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="5,4"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Caminho Antigo" Width="2*" MinWidth="200" SortMemberPath="CaminhoAntigoExe">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CaminhoAntigoExe}" VerticalAlignment="Center" Margin="5,2"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.6" ToolTip="{Binding CaminhoAntigoExe}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Novo Caminho Encontrado" Width="3*" MinWidth="250" SortMemberPath="NovoCaminhoExe">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NovoCaminhoExe}" VerticalAlignment="Center" Margin="5,2"
                                                   Foreground="LightGreen" Opacity="0.9" ToolTip="{Binding NovoCaminhoExe}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="🚫 MARCAR COMO DESINSTALADOS" Command="{Binding MarkNotFoundAsUninstalledCommand}" Padding="15,10" FontWeight="Bold" Background="#22FF0000" Margin="0,0,10,0" />
                        <Button Content="🔧 RELINKAR SELECIONADOS" Command="{Binding RelinkSelectedCommand}" Padding="20,10" FontWeight="Bold" Background="#22FF8800" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <!-- ABA 5: EXCLUÍDOS -->
            <TabItem Header="Excluídos">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock Text="Jogos ignorados nas buscas. Selecione um item e clique em 'Remover da Lista' para que volte a aparecer nos resultados futuros."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </Border>

                    <DataGrid x:Name="ExcludedGrid" Grid.Row="1"
                              ItemsSource="{Binding ExcludedView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="#11FFFFFF"
                              BorderThickness="1"
                              HorizontalAlignment="Stretch"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jogo" Binding="{Binding NomeJogo}" Width="*" />
                            <DataGridTextColumn Header="Pasta de Origem" Binding="{Binding PastaMonitoradaPai}" Width="*" />
                            <DataGridTextColumn Header="Excluído em" Binding="{Binding DataExclusao}" Width="140" />
                            <DataGridTextColumn Header="Caminho do Exe" Binding="{Binding CaminhoExe}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding CaminhoExe}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="🔁 Remover Selecionado da Lista de Excluídos"
                            Command="{Binding RemoveExcludedCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=ExcludedGrid}"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Cursor="Hand" />
                </Grid>
            </TabItem>
            <!-- ABA 6: DESINSTALADOS -->
            <TabItem Header="Desinstalados">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock Text="Histórico de jogos marcados como desinstalados pela extensão. Clique em 'Reinstalar' para marcar o jogo como instalado novamente. Se a pasta do jogo mudou, use a aba 'Reparar Desinstalados' para reapontar o caminho."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoricoDesinstalacoesView}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#11FFFFFF" BorderThickness="1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              CanUserResizeColumns="True" CanUserReorderColumns="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataDesinstalacao}" Width="150" />
                            <DataGridTextColumn Header="Jogo" Binding="{Binding NomeJogo}" Width="*" />
                            <DataGridTextColumn Header="Local de Origem" Binding="{Binding Origem}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Origem}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Ação" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="↩️ Reinstalar"
                                                Command="{Binding DataContext.ReinstalarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Margin="2" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="Limpar Histórico de Desinstalações"
                            Command="{Binding ClearUninstallHistoryCommand}"
                            Margin="0,10,0,0" HorizontalAlignment="Right" />
                </Grid>
            </TabItem>
            <!-- ABA 7: DUPLICADOS -->
            <TabItem Header="Duplicados">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="Localiza jogos locais duplicados (mesmo nome). Para cada cópia, o plugin verifica se há um save dentro da pasta. Cópias SEM save são consideradas seguras e já vêm marcadas para remoção. Ao remover, a pasta é enviada para a Lixeira e o jogo é retirado da biblioteca (registrado em 'Duplicados Removidos'). Ao menos uma cópia de cada jogo é sempre mantida." />
                    </Border>

                    <!-- CONFIGURAÇÃO DOS PADRÕES DE SAVE -->
                    <Expander Grid.Row="1" Header="Padrões de save (pastas/arquivos que indicam progresso salvo)"
                              Foreground="Gold" FontWeight="Bold" IsExpanded="False" Margin="0,0,0,10">
                        <Border Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,5,0,0">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontWeight="Normal" FontSize="11" Margin="0,0,0,8"
                                           Text="Use nomes de pasta/arquivo (ex: saves) ou extensões iniciadas por ponto (ex: .sav). Se qualquer um destes for encontrado dentro da pasta do jogo, a cópia é tratada como 'com save' e não vem marcada para remoção." />
                                <Button Content="➕ Adicionar padrão" Command="{Binding AddSavePatternCommand}"
                                        Padding="10,4" HorizontalAlignment="Left" FontWeight="Normal" Margin="0,0,0,8" Cursor="Hand" />
                                <ItemsControl ItemsSource="{Binding Settings.PadroesSave}" MaxHeight="140">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Button Content="✖" Command="{Binding DataContext.RemoveSavePatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Padding="4,0" Margin="0,0,8,0" FontWeight="Normal" Cursor="Hand" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Normal" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔍 PROCURAR DUPLICADOS" Command="{Binding SearchDuplicatesCommand}" Padding="15,8" FontWeight="Bold" />
                        <TextBlock Text="Agrupa jogos locais com o mesmo nome e verifica saves." VerticalAlignment="Center" Margin="15,0,0,0" Opacity="0.7" />
                    </StackPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding DuplicatasView}"
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                              Background="#11FFFFFF" BorderThickness="1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              CanUserResizeColumns="True" CanUserReorderColumns="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Apagar" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="2"
                                                Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Save" Width="150" SortMemberPath="SaveStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="5,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Pasta de Instalação" Width="3*" MinWidth="250" SortMemberPath="InstallDir">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InstallDir}" VerticalAlignment="Center" Margin="5,2"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.85"
                                                   ToolTip="{Binding InstallDir}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="5,4" Foreground="OrangeRed" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="4" Content="🗑️ ENVIAR SELECIONADOS PARA A LIXEIRA"
                            Command="{Binding RemoveDuplicatesCommand}"
                            Margin="0,10,0,0" Padding="20,10" FontWeight="Bold" Background="#22FF0000" HorizontalAlignment="Right" />
                </Grid>
            </TabItem>
            <!-- ABA 8: DUPLICADOS REMOVIDOS -->
            <TabItem Header="Duplicados Removidos">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock Text="Registro das pastas de jogos duplicados enviadas para a Lixeira. Caso precise recuperar, restaure a pasta pela Lixeira do Windows e reimporte o jogo."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DuplicatasRemovidasView}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#11FFFFFF" BorderThickness="1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              CanUserResizeColumns="True" CanUserReorderColumns="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataRemocao}" Width="150" />
                            <DataGridTextColumn Header="Jogo" Binding="{Binding NomeJogo}" Width="*" />
                            <DataGridTextColumn Header="Tinha Save" Binding="{Binding TinhaSave}" Width="90" />
                            <DataGridTextColumn Header="Destino" Binding="{Binding Destino}" Width="90" />
                            <DataGridTextColumn Header="Pasta Removida" Binding="{Binding PastaRemovida}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding PastaRemovida}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="Limpar Histórico de Duplicados Removidos"
                            Command="{Binding ClearDuplicateHistoryCommand}"
                            Margin="0,10,0,0" HorizontalAlignment="Right" />
                </Grid>
            </TabItem>
            <!-- ABA 9: ATUALIZAÇÕES -->
            <TabItem Header="Atualizações">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#11FFFFFF" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Atualização da extensão" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding VersaoInstaladaTexto}" Margin="0,0,0,10" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12"
                                       Text="Consulta as releases publicadas no GitHub. Havendo versão mais nova, o arquivo é baixado e, com sua confirmação, o Playnite fecha, os arquivos são trocados e ele abre de novo já na versão nova. Confira aqui depois de reiniciar: a versão instalada acima é a prova de que a troca deu certo." />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔄 Verificar atualizações"
                                        Command="{Binding CheckUpdateCommand}"
                                        Padding="15,8" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" />
                                <Button Content="📄 Ver log da última atualização"
                                        Command="{Binding AbrirLogAtualizacaoCommand}"
                                        Padding="15,8" Cursor="Hand" />
                            </StackPanel>
                            <TextBlock Text="{Binding RepositorioUrl}" Opacity="0.5" FontSize="11" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
