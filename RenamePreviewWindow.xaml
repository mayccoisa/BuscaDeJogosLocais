<UserControl x:Class="BuscaDeJogosLocais.RenamePreviewWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="20,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TitleBar}" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding HeaderText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageDescription}" Margin="18,8,0,0"
                           Text="Confira o nome novo antes de aplicar. Nome e versão são editáveis na tabela, e nada é gravado até você aplicar." />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Style="{StaticResource GhostButton}" Content="Marcar todos" Click="OnMarcarTodosClick" />
                <Button Style="{StaticResource GhostButton}" Content="Desmarcar todos" Click="OnDesmarcarTodosClick" Margin="0,0,20,0" />
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding ContagemTexto}" />
            </StackPanel>

            <DataGrid x:Name="GridRenomeacoes" Grid.Row="2" Style="{StaticResource ThemedDataGrid}"
                      ItemsSource="{Binding Itens}" SelectionMode="Extended"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center" Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Nome atual" Width="*" SortMemberPath="NomeAtual">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PathText}" Text="{Binding NomeAtual}" ToolTip="{Binding NomeAtual}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Nome novo" Binding="{Binding NomeNovo, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Versão" Binding="{Binding Versao, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
                <Grid>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0"
                            Content="Cancelar" Click="OnFecharClick" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0"
                            Content="Aplicar selecionados" Click="OnAplicarClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
