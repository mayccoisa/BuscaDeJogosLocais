<UserControl x:Class="BuscaDeJogosLocais.RenamePreviewWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BuscaDeJogosLocais"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding HeaderText}" FontSize="14" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Confira o nome novo antes de aplicar. Você pode editar o nome e a versão direto na tabela — nada é gravado até clicar em Aplicar."
                       TextWrapping="Wrap" FontStyle="Italic" Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Seleção -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Marcar todos" Click="OnMarcarTodosClick" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Desmarcar todos" Click="OnDesmarcarTodosClick" Padding="10,4" Margin="0,0,20,0" Cursor="Hand" />
            <TextBlock Text="{Binding ContagemTexto}" VerticalAlignment="Center" Opacity="0.7" FontSize="11" />
        </StackPanel>

        <DataGrid x:Name="GridRenomeacoes" Grid.Row="2"
                  ItemsSource="{Binding Itens}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="#22FFFFFF"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#11FFFFFF"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#22FFFFFF"
                  HeadersVisibility="Column"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Aplicar" Width="65" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Nome atual" Binding="{Binding NomeAtual}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Nome novo" Binding="{Binding NomeNovo, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="LightGreen" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Versão" Binding="{Binding Versao, UpdateSourceTrigger=PropertyChanged}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✅ APLICAR SELECIONADOS" Click="OnAplicarClick"
                    Padding="15,7" Margin="0,0,10,0" Cursor="Hand" />
            <Button Content="Cancelar" Click="OnFecharClick" Padding="15,7" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
