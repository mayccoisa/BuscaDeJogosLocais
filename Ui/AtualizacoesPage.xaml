<UserControl x:Class="BuscaDeJogosLocais.Ui.AtualizacoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18,20,20" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Style="{StaticResource TitleBar}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Atualizações" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               Text="A extensão consulta as releases publicadas no GitHub e aplica a troca sozinha, com a sua confirmação." />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource HeroCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Versão instalada" />
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding VersaoInstaladaTexto}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="Este número é lido do arquivo da extensão, e é a única prova de que uma atualização foi aplicada de verdade. O diálogo de confirmação não é prova: ele só diz que o download terminou." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Como a troca acontece" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Havendo versão nova, o arquivo é baixado e, com a sua confirmação, o Playnite fecha, os arquivos da extensão são trocados na pasta dela e o Playnite abre de novo já na versão nova. Se alguma vez a versão acima não subir, o log diz em que passo parou." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Verificar atualizações"
                                Command="{Binding CheckUpdateCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Ver log da última atualização"
                                Command="{Binding AbrirLogAtualizacaoCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Separator}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding RepositorioUrl}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
