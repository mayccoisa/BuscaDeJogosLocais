<UserControl x:Class="BuscaDeJogosLocais.Ui.AjustesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!--
        As opções que moravam dentro da aba "Pastas Monitoradas". Elas ficam numa página
        rolável e própria porque crescem a cada versão — e foi crescendo assim que uma delas
        empurrou a tabela de pastas para fora da tela.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18,20,20" MaxWidth="880" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Style="{StaticResource TitleBar}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Ajustes" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               Text="Como o jogo entra na biblioteca: nome, versão, identificação de disco, fonte e metadados." />
                </StackPanel>
            </StackPanel>

            <!-- Nome e versão -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Nome e versão" />
                    <CheckBox Content="Limpar o nome da pasta ao importar" IsChecked="{Binding Settings.LimparNomeDaPasta}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource HintText}" Margin="27,2,0,0"
                               Text="Remove versão, grupo de release e ruído. &quot;STARDUST.Wish.of.Witch.v20260729-P2P&quot; vira &quot;Stardust Wish of Witch&quot;, e o nome continua editável na lista antes de importar." />

                    <CheckBox Content="Guardar a versão detectada no campo Versão do jogo" IsChecked="{Binding Settings.GuardarVersaoDetectada}" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource HintText}" Margin="27,2,0,0"
                               Text="A versão que estava no nome da pasta (v1.00.1, Build 12345, Update 3) não se perde: vai para o campo nativo do Playnite." />

                    <Button Style="{StaticResource GhostButton}" Margin="27,14,0,0"
                            Content="Limpar nomes dos jogos já importados" Command="{Binding LimparNomesExistentesCommand}" />
                </StackPanel>
            </Border>

            <!-- Identificação -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Identificação na biblioteca" />

                    <CheckBox Content="Identificar o HD (ex.: &quot;HD D:&quot;) como Característica ao importar"
                              IsChecked="{Binding Settings.TagDriveAsFeature}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource HintText}" Margin="27,2,0,0"
                               Text="Adiciona a letra do disco ao jogo, o que deixa filtrar por onde ele está instalado." />
                    <Button Style="{StaticResource GhostButton}" Margin="27,10,0,0"
                            Content="Aplicar tags de HD nos jogos já importados" Command="{Binding UpdateExistingGamesDriveCommand}" />

                    <Border Style="{StaticResource Separator}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Fonte &quot;Local&quot;" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,0"
                               Text="Marca os jogos com a Fonte &quot;Local&quot;, que é o que os temas usam para separar as bibliotecas na tela de perfil." />
                    <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                            Content="Marcar jogos já importados como Fonte Local" Command="{Binding ApplyLocalSourceToExistingCommand}" />

                    <Border Style="{StaticResource Separator}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Jogos de emulação: biblioteca por console" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,0"
                               Text="Jogo de emulação entra sem Fonte nenhuma e some num balde só. Aqui a extensão lê o emulador (e o perfil) que cada jogo referencia e usa o console como Fonte: PlayStation 2, Nintendo Switch, Game Boy Advance. Você confere e edita numa prévia antes de gravar." />
                    <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                            Content="Completar biblioteca dos jogos de emulação" Command="{Binding CompletarBibliotecaCommand}" />
                </StackPanel>
            </Border>

            <!-- Metadados -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Metadados" />
                    <CheckBox Content="Baixar metadados dos jogos logo após importar"
                              IsChecked="{Binding Settings.BaixarMetadadosAposImportar}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource HintText}" Margin="27,2,0,0"
                               Text="Busca capa, ícone, fundo, descrição, gêneros e data de lançamento nas fontes instaladas no Playnite. Campo já preenchido nunca é sobrescrito." />
                </StackPanel>
            </Border>

            <!-- Scan automático -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Busca automática" />
                    <CheckBox Content="Escanear ao iniciar o Playnite" IsChecked="{Binding Settings.EscanearAutomaticamente}" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="27,10,0,0"
                                IsEnabled="{Binding Settings.EscanearAutomaticamente}">
                        <TextBlock Style="{StaticResource StatusLabel}" Text="Intervalo entre buscas (dias):" Margin="0,0,10,0" />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding Settings.IntervaloScanDias, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource MutedText}" Margin="27,10,0,0" Text="{Binding UltimoScanTexto}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
