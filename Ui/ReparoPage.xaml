<UserControl x:Class="BuscaDeJogosLocais.Ui.ReparoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!--
        Era a aba "Reparar Desinstalados", e o nome já entregava a saída errada: ela existia
        para desinstalar. A tela agora mostra POR QUE cada jogo casou com a pasta encontrada,
        e a ação em destaque é reapontar; desinstalar ficou como ação secundária, disponível
        só para o que realmente não foi achado.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource TitleBar}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Jogos que sumiram" />
                <TextBlock Style="{StaticResource PageDescription}"
                           Text="Jogos cuja pasta ou executável não está mais onde a biblioteca aponta. A busca varre as pastas monitoradas e diz em que evidência se baseou para achar cada um." />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,16,0" VerticalAlignment="Center"
                        Content="Procurar no disco" Command="{Binding SearchLostGamesCommand}" />
                <TextBlock Style="{StaticResource StatusLabel}" MaxWidth="620"
                           Text="Só entra na lista o que está faltando de verdade. Pasta que apenas mudou de lugar aparece como &quot;Mudou de pasta&quot; e já vem marcada; o que ficou em &quot;Provável&quot; pede sua conferência antes." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource ThemedDataGrid}"
                  ItemsSource="{Binding JogosParaRelinkarView}"
                  SelectionMode="Single" CanUserResizeColumns="True" CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Jogo" Width="2*" MinWidth="200" SortMemberPath="Nome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource PathText}" Margin="0,2,0,0"
                                           Text="{Binding CaminhoAntigoExe}" ToolTip="{Binding CaminhoAntigoExe}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Situação" Width="160" MinWidth="150" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- A coluna que faltava. Sem ela a tela pedia fé: aparecia um caminho novo e
                     não havia como saber se o casamento veio de prova ou de palpite. -->
                <DataGridTemplateColumn Header="Por quê" Width="2*" MinWidth="220" SortMemberPath="Motivo">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Motivo}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       ToolTip="{Binding Motivo}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Pasta encontrada agora" Width="3*" MinWidth="240" SortMemberPath="NovoInstallDirectory">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NovoInstallDirectory, Converter={StaticResource TextOrDash}}"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{StaticResource GreenBrush}"
                                       ToolTip="{Binding NovoCaminhoExe}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Duas colunas, e não um Grid de célula única: o texto de aviso é longo e passava por
             baixo dos botões, que é justamente onde ele fica ilegível. -->
        <Border Grid.Row="3" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="Antes de desinstalar, confira se a pasta atual do jogo é uma das monitoradas — o que não é vigiado não tem como ser encontrado." />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Content="Marcar como desinstalados" Command="{Binding MarkNotFoundAsUninstalledCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="0"
                            Content="Reapontar selecionados" Command="{Binding RelinkSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
