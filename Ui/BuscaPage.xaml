<UserControl x:Class="BuscaDeJogosLocais.Ui.BuscaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource TitleBar}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Busca e importação" />
                <TextBlock Style="{StaticResource PageDescription}"
                           Text="A lista já abre com os jogos locais que estão na biblioteca. Escanear procura no disco o que ainda não entrou — e reconhece o que apenas mudou de pasta." />
            </StackPanel>
        </StackPanel>

        <!-- Filtros e ação de busca na mesma linha: eram dois blocos empilhados que empurravam
             a tabela para baixo. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                        Content="{Binding ScanButtonLabel}" Command="{Binding ScanNowCommand}"
                        Margin="0,0,16,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource StatusLabel}" Text="Pasta:" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding OpcoesPastas}" SelectedValue="{Binding FiltroPastaSelecionada}"
                              Width="230" VerticalAlignment="Center" />
                    <CheckBox Content="Ocultar o que já está na biblioteca" IsChecked="{Binding FiltrarApenasNovos}"
                              VerticalAlignment="Center" Margin="18,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso das pastas que mudaram de lugar. Aparece só quando existe alguma, e vem antes
             da tabela porque reapontar é a ação certa nesse caso — importar duplicaria o jogo. -->
        <Border Grid.Row="2" Style="{StaticResource OkBanner}"
                Visibility="{Binding TotalMudaramDePasta, Converter={StaticResource CountToVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BannerGlyph}"
                        Background="#2A70D89B" BorderBrush="#A870D89B">
                    <TextBlock Style="{StaticResource BannerGlyphText}" Foreground="{StaticResource GreenBrush}" Text="→" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource BannerTitle}" Text="{Binding MudaramDePastaTitulo}" />
                    <TextBlock Style="{StaticResource BannerText}"
                               Text="Estas pastas não são jogos novos: são jogos que a biblioteca já tem e que mudaram de lugar ou de nome. Reapontar mantém o registro, o tempo de jogo, as capas e as tags; importar criaria um segundo jogo igual." />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource BannerButton}"
                        Content="Reapontar" Command="{Binding ReapontarMovidosCommand}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" Style="{StaticResource ThemedDataGrid}"
                  ItemsSource="{Binding JogosEncontradosView}"
                  SelectionMode="Single" CanUserResizeColumns="True" CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding JaExiste, Converter={StaticResource InverseBoolean}}"
                                      HorizontalAlignment="Center" Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Jogo" Width="2*" MinWidth="220" SortMemberPath="Nome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding NomeOriginal}" />
                                <!-- De onde o jogo veio só interessa quando ele mudou de casa. -->
                                <TextBlock Style="{StaticResource PathText}" Margin="0,2,0,0"
                                           Text="{Binding MovidoDePasta, StringFormat=antes em {0}}"
                                           ToolTip="{Binding MotivoMudanca}"
                                           Visibility="{Binding EhMudancaDePasta, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Situação" Width="150" MinWidth="140" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Versão" Width="110" SortMemberPath="Versao">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource PathText}"
                                       Text="{Binding Versao, Converter={StaticResource TextOrDash}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Última verificação" Width="140" SortMemberPath="UltimaVerificacao">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource PathText}" Text="{Binding UltimaVerificacao}"
                                       ToolTip="Data do último scan que confirmou esta pasta no disco" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Pasta" Width="3*" MinWidth="240" SortMemberPath="PastaRaiz">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource PathText}" Text="{Binding PastaRaiz}"
                                       ToolTip="{Binding PastaRaiz}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="{Binding ScanHintText}" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="0"
                        Content="Importar selecionados" Command="{Binding ImportSelectedCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
