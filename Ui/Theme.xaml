<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:BuscaDeJogosLocais.Ui"
                    xmlns:local="clr-namespace:BuscaDeJogosLocais">

    <!--
        O visual desta extensao segue o mesmo padrao do Playnite Hub (extensao irma), que por
        sua vez saiu do BAML da tela de configuracoes do Aniki Helper. Os valores abaixo sao os
        literais lidos de la, nao aproximacoes de captura de tela: superficie escura levemente
        azulada, borda ciano tenue, sombra difusa, acento ciano e o dourado reservado para a
        aba selecionada. As duas extensoes compartilharem o dicionario e o que faz elas
        parecerem do mesmo autor quando instaladas lado a lado.

        A paleta e escura por decisao, como a do proprio Aniki. Nao derivamos as
        superficies dos brushes do tema do Playnite porque a maior parte deles nao existe
        com o mesmo nome em todo tema instalado, e um DynamicResource que nao resolve
        deixa o painel transparente. So a fonte e herdada do tema, para a extensao
        continuar parecendo parte do app da pessoa.

        Regra que nao deve ser "simplificada": cor so aparece AQUI. A tela antiga tinha
        #11FFFFFF, Gold, LightGreen e OrangeRed espalhados por 726 linhas de XAML, e mudar o
        visual significava caçar literal por literal. A unica excecao e a cor semantica de
        status, que carrega significado e sai do StatusToBrushConverter.
    -->

    <!-- ============================ Cores ============================ -->

    <SolidColorBrush x:Key="Surface1Brush"        Color="#E61A2026" />
    <SolidColorBrush x:Key="BorderBrushSoft"      Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BorderBrushHover"     Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush"       Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#FFB3B3B3" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="AccentBrush"          Color="#FF32CFE5" />
    <SolidColorBrush x:Key="AccentSoftBrush"      Color="#3A32CFE5" />
    <SolidColorBrush x:Key="GoldBrush"            Color="#FFE6B86A" />
    <SolidColorBrush x:Key="GreenBrush"           Color="#FF70D89B" />
    <SolidColorBrush x:Key="AmberBrush"           Color="#FFE5A16A" />
    <SolidColorBrush x:Key="DangerBrush"          Color="#FFFF7474" />
    <SolidColorBrush x:Key="PanelBorderBrush"     Color="#38FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"      Color="#3547D7E9" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#B8141B22" />
    <SolidColorBrush x:Key="FieldBorderBrush"     Color="#30FFFFFF" />

    <!-- Cores cruas, para quem desenha grafico em codigo. -->
    <Color x:Key="ChartEmptyColor">#33888888</Color>
    <Color x:Key="ChartGridColor">#22FFFFFF</Color>

    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E90D1319" Offset="0" />
        <GradientStop Color="#E6071119" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F21D2329" Offset="0" />
        <GradientStop Color="#EC14191F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HomeCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0182029" Offset="0" />
        <GradientStop Color="#F00C151D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8182028" Offset="0" />
        <GradientStop Color="#DB10171D" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================ Conversores ============================ -->

    <ui:BoolToOnOffConverter x:Key="OnOff" />
    <local:GroupCountConverter x:Key="GroupCount" />
    <local:InverseBooleanConverter x:Key="InverseBoolean" />
    <ui:BoolToStatusBrushConverter x:Key="OnOffBrush" />
    <ui:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />
    <ui:FilledStringToVisibilityConverter x:Key="FilledToVisible" />
    <ui:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <ui:NullableDateToTextConverter x:Key="Stamp" />
    <ui:TextOrDashConverter x:Key="TextOrDash" />

    <!-- ============================ Texto ============================ -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,14,0,5" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,7,0,0" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StatusLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Superficies ============================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,15,18,17" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource HomeCardBackgroundBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.32" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource HeroBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#3047D7E9" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Linha de lista: mesma familia do card, sem sombra e com folga menor. Sombra em cada
        item de uma lista de dez aparelhos vira ruido, e nao hierarquia.
    -->
    <Style x:Key="RowCard" TargetType="Border">
        <Setter Property="Background" Value="#12FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Etiqueta de tipo, no fim da linha do aparelho. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#1832CFE5" />
        <Setter Property="BorderBrush" Value="#4032CFE5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A barrinha vertical a esquerda do titulo de pagina. -->
    <Style x:Key="TitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,2,14,2" />
    </Style>

    <Style x:Key="Separator" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,14,0,14" />
    </Style>

    <!-- Quadradinho com a inicial, no cabecalho de cada card da Home. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="#2232CFE5" />
        <Setter Property="BorderBrush" Value="#7032CFE5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GoldBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="#22E6B86A" />
        <Setter Property="BorderBrush" Value="#70E6B86A" />
    </Style>

    <Style x:Key="GoldBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>

    <!-- ============================ Avisos ============================ -->

    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="#22E6B86A" />
        <Setter Property="BorderBrush" Value="#58E6B86A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="DangerBanner" TargetType="Border" BasedOn="{StaticResource WarningBanner}">
        <Setter Property="Background" Value="#26FF5C5C" />
        <Setter Property="BorderBrush" Value="#78FF5C5C" />
    </Style>

    <Style x:Key="OkBanner" TargetType="Border" BasedOn="{StaticResource WarningBanner}">
        <Setter Property="Background" Value="#1E39C878" />
        <Setter Property="BorderBrush" Value="#5536D17A" />
    </Style>

    <Style x:Key="BannerTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BannerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C8D0D5D9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Bolinha com o glifo, a esquerda do banner. -->
    <Style x:Key="BannerGlyph" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="#2AE6B86A" />
        <Setter Property="BorderBrush" Value="#A8E6B86A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="BannerGlyphText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Botoes ============================ -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Margin" Value="0,0,8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#1732CFE5"
                            BorderBrush="#6A32CFE5"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2732CFE5" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#B032CFE5" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#32CFE5" BlurRadius="12" ShadowDepth="0" Opacity="0.20" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1232CFE5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#B032CFE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#26FF5C5C"
                            BorderBrush="#A6FF5C5C"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3DFF5C5C" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#E6FF7474" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF5C5C" BlurRadius="12" ShadowDepth="0" Opacity="0.22" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1FFF5C5C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botao discreto, para acao secundaria dentro de um card. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#10FFFFFF"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AFFFFFF" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderBrushHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botao do banner: fica a direita, alinhado ao centro do bloco de texto. -->
    <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Campos ============================ -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{StaticResource FieldBackgroundBrush}"
                            BorderBrush="{StaticResource FieldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderBrushHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#8532CFE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumberBox" TargetType="TextBox">
        <Setter Property="Width" Value="70" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box"
                                Width="17" Height="17"
                                CornerRadius="5"
                                Background="#14FFFFFF"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="check"
                                  Data="M 0,3.6 L 3.1,6.8 L 8.6,0.6"
                                  Stroke="#FF0E1418"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="label"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#8532CFE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Abas do topo ============================ -->

    <Style x:Key="TopTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,10,18,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,12,18,8" />
        <Setter Property="Margin" Value="2,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Border x:Name="SelectedLine"
                                Grid.Row="1"
                                Height="2"
                                Margin="10,0"
                                CornerRadius="1"
                                Background="{StaticResource GoldBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Abas laterais ============================ -->

    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" IsItemsHost="True" Margin="0,2,0,0" MinWidth="170" />
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="17,11" />
        <Setter Property="Margin" Value="0,0,14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="SideTabBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="4,0,0,0"
                            CornerRadius="0,10,10,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SideTabBorder" Property="Background" Value="#2032CFE5" />
                            <Setter TargetName="SideTabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SideTabBorder" Property="Background" Value="#1432CFE5" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Tabelas ============================ -->

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0E32CFE5" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2032CFE5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#10FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#08FFFFFF" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>


    <!-- ==================================================================== -->
    <!--  Acréscimos desta extensão ao padrão herdado do Playnite Hub          -->
    <!--  A base veio de lá inteira; aqui entra só o que esta extensão tem e   -->
    <!--  aquela não tinha: tabela agrupada por pasta, combo de filtro,        -->
    <!--  expander e as pílulas de situação das linhas.                        -->
    <!-- ==================================================================== -->

    <ui:StatusToBrushConverter x:Key="StatusBrush" />
    <ui:CountToVisibilityConverter x:Key="CountToVisible" />
    <ui:CountToBrushConverter x:Key="CountToBrush" />
    <ui:NegateBooleanConverter x:Key="Negate" />

    <!-- Cabeçalho de grupo da tabela: uma pasta monitorada por bloco. -->
    <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,0,0,6">
                        <Expander.Header>
                            <Border Background="#14FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="7" Padding="12,7" Margin="0,4,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource GoldBrush}" />
                                    <TextBlock Margin="10,0,0,0" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               ToolTip="Jogos desta pasta na biblioteca / total de pastas encontradas no disco">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource GroupCount}">
                                                <Binding Path="Name" />
                                                <Binding Path="ItemCount" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Expander.Header>
                        <ItemsPresenter />
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pílula de situação: o texto do status ganha fundo próprio, para a linha ser lida
         de relance numa tabela de 200 jogos. A cor vem do conversor, não do XAML. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="#12FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PathText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Número grande dos indicadores da tela Início. -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--
        O ComboBox precisa de ControlTemplate INTEIRO, e o item da lista precisa de estilo
        próprio. Trocar só Background e Foreground pinta o fecho e deixa o popup no template
        padrão do WPF: fundo branco, e o item sob o mouse com o amarelo do realce do sistema.
        O popup é uma árvore visual separada, então ele não herda nada do controle.
    -->
    <!-- ============================ Barra de rolagem ============================ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tampa" Background="#3AFFFFFF" CornerRadius="4" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tampa" Property="Background" Value="#5CFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tampa" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- As setas das pontas somem: elas são o pedaço mais claro da barra padrão, e ninguém
         clica nelas quando a roda do mouse existe. -->
    <Style x:Key="ScrollSemBotao" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Com chave, porque o popup do ComboBox precisa reaplicá-la na própria árvore dele
         (mesmo motivo do ThemedComboItem). O estilo implícito logo abaixo herda desta. -->
    <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollSemBotao}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollSemBotao}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="11" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A implícita, para as tabelas e páginas roláveis. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}" />

    <!--
        Com chave, e amarrado por ItemContainerStyle logo abaixo. Só implícito NÃO basta: o
        container do item é gerado dentro do popup, que é outra árvore visual, e a busca do
        estilo implícito não chega lá — medido em 24/08/2026, o popup ficava com a barra de
        seleção clara e o texto escuro do tema do Windows dentro do painel escuro.
    -->
    <Style x:Key="ThemedComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="itemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="5"
                            Margin="3,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="#2032CFE5" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="#2E32CFE5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- O ToggleButton É o fecho: ele ocupa a área toda para o clique abrir
                             a lista em qualquer ponto, e não só na setinha. -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="fecho"
                                            Background="{StaticResource FieldBackgroundBrush}"
                                            BorderBrush="{StaticResource FieldBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  Data="M 0,0 L 9,0 L 4.5,5.5 Z"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Margin="0,0,11,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fecho" Property="BorderBrush" Value="{StaticResource BorderBrushHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="fecho" Property="BorderBrush" Value="#8532CFE5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <!-- O campo editável existe para o WPF não reclamar do PART esperado;
                             nossos combos são só de escolha. -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" />

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               Focusable="False">
                            <Border Background="{StaticResource Surface1Brush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.45" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <!-- A barra tem que ser reaplicada AQUI. A implícita do
                                         dicionário não alcança o que nasce dentro do popup,
                                         e sem isto sobra uma barra branca do Windows
                                         encostada no painel escuro. -->
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O Expander padrão desenha a setinha dentro de um quadradinho com borda clara do
         sistema. Ele aparece no cabeçalho de grupo de TODAS as tabelas agrupadas, então é
         chrome de sistema espalhado pela tela inteira. -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton Grid.Row="0"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="seta"
                                                  Data="M 0,0 L 5,4.5 L 0,9 Z"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Margin="2,0,9,0"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.4,0.5" />
                                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- O giro vai no RenderTransform do próprio Path: um
                                             x:Name dentro do transform não é alvo válido de
                                             TargetName, e o XAML nem compila (MC4111). -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="seta" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="seta" Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="seta" Property="Fill" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>

                        <ContentPresenter x:Name="corpo" Grid.Row="1" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="corpo" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!--
        Tudo abaixo tem a mesma razão de existir do template do ComboBox: são superfícies que
        o WPF desenha FORA da árvore visual da tela (popup, dica, menu) ou com chrome próprio
        do sistema. Elas não herdam nada do painel, então sem template explícito aparecem no
        cinza-claro/branco padrão do Windows em cima de um painel escuro.
    -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Surface1Brush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,7">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.40" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caminho de pasta é longo: a dica quebra linha em vez de virar uma régua de 2000px. -->
    <Style TargetType="TextBlock" x:Key="ToolTipText">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>


    <!-- Rodapé de ações: a barra fixa embaixo de cada página que age em lote. -->
    <Style x:Key="ActionBar" TargetType="Border">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,11" />
    </Style>

    <!-- Botão dentro de célula de tabela: menor que o de página, e sem margem embaixo. -->
    <Style x:Key="CellButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
