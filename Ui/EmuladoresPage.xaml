<UserControl x:Class="BuscaDeJogosLocais.Ui.EmuladoresPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!--
        A aba de emuladores é a gêmea de "Pastas monitoradas", do lado da emulação: mesma
        pergunta, mesmo formato de tabela, mesmos dois botões por linha. Quem aprendeu a ler uma
        não precisa aprender a outra.

        A tabela ocupa a página inteira e tem altura mínima própria — foi a linha "*" espremida
        por blocos de configuração que fez a tabela de pastas sumir com zero pixel uma vez.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource TitleBar}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Emuladores" />
                <TextBlock Style="{StaticResource PageDescription}"
                           Text="Os emuladores configurados no Playnite, com a versão de cada um e o que há nas pastas que ele varre — quanto já virou jogo na biblioteca e quanto ficou de fora." />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                        Content="Atualizar" Command="{Binding AtualizarEmuladoresCommand}" />
                <Button Style="{StaticResource GhostButton}" Margin="0,0,16,0" VerticalAlignment="Center"
                        Content="Abrir pasta dos logs" Command="{Binding AbrirPastaDosLogsCommand}"
                        ToolTip="Emulador 'não encontrado' deixa no extensions.log uma linha [Emulador] dizendo qual pasta e qual padrão de executável falharam." />
                <TextBlock Style="{StaticResource StatusLabel}" MaxWidth="620" TextWrapping="Wrap"
                           Text="A leitura varre as pastas de ROM inteiras, então ela é sob demanda: numa coleção grande são dezenas de milhares de arquivos, e fazer isso na abertura travaria a tela." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource ThemedDataGrid}"
                  ItemsSource="{Binding Emuladores}" IsReadOnly="True"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Emulador" Width="*" MinWidth="200" SortMemberPath="Nome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- O ícone sai do próprio .exe do emulador: o Playnite não
                                     distribui ícone de emulador nenhum. Sem ícone a coluna
                                     encolhe para zero em vez de deixar um quadrado vazio. -->
                                <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Source="{Binding Icone}"
                                       Visibility="{Binding TemIcone, Converter={StaticResource BoolToVisible}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Nome}" FontSize="12.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Executavel}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Versão" Binding="{Binding Versao}" Width="120" />

                <DataGridTemplateColumn Header="Console" Width="170" SortMemberPath="Plataformas">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Plataformas}" FontSize="12.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Plataformas}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Situação" Width="180" SortMemberPath="StatusTexto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding StatusTexto}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding StatusTexto, Converter={StaticResource StatusBrush}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Na biblioteca" Binding="{Binding NaBiblioteca}" Width="105" />
                <DataGridTextColumn Header="Fora" Binding="{Binding ForaDaBiblioteca}" Width="70" />

                <DataGridTemplateColumn Header="" Width="200" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CellButton}" Content="Ver jogos"
                                        Command="{Binding DataContext.VerJogosDoEmuladorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource CellButton}" Margin="6,0,0,0"
                                        Content="Abrir pasta"
                                        ToolTip="Abre a pasta de varredura deste emulador no Explorador do Windows."
                                        Command="{Binding DataContext.AbrirPastaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="{Binding EmuladoresResumoTexto}" />
        </Border>
    </Grid>
</UserControl>
