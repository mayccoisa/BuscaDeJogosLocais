<UserControl x:Class="BuscaDeJogosLocais.Ui.DuplicadosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource TitleBar}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Duplicados" />
                <TextBlock Style="{StaticResource PageDescription}"
                           Text="A mesma instalação em mais de uma pasta. Cópia sem save é considerada segura e já vem marcada; ao menos uma cópia de cada jogo é sempre mantida." />
            </StackPanel>
        </StackPanel>

        <!-- Aviso de ação destrutiva: a pasta vai para a Lixeira, então a consequência precisa
             estar visível ANTES do botão, e não escondida no texto de ajuda. -->
        <Border Grid.Row="1" Style="{StaticResource WarningBanner}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BannerGlyph}">
                    <TextBlock Style="{StaticResource BannerGlyphText}" Text="!" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource BannerTitle}" Text="Remover aqui apaga a pasta do disco" />
                    <TextBlock Style="{StaticResource BannerText}"
                               Text="A pasta vai para a Lixeira do Windows e o jogo sai da biblioteca, com registro em Histórico › Duplicados removidos. Para recuperar, restaure pela Lixeira e importe de novo." />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <Expander Header="Padrões de save (o que indica progresso salvo dentro da pasta)" IsExpanded="False" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" FontWeight="Normal"
                                   Text="Nome de pasta/arquivo (ex.: saves) ou extensão começando com ponto (ex.: .sav). Achando qualquer um deles dentro da pasta do jogo, a cópia é tratada como &quot;com save&quot; e não vem marcada para remoção." />
                        <Button Style="{StaticResource GhostButton}" Content="Adicionar padrão" Command="{Binding AddSavePatternCommand}" />
                        <ItemsControl ItemsSource="{Binding Settings.PadroesSave}" MaxHeight="150" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Button Style="{StaticResource CellButton}" Content="✕" Margin="0,0,10,0"
                                                Command="{Binding DataContext.RemoveSavePatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Normal" FontSize="12.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,16,0" VerticalAlignment="Center"
                            Content="Procurar duplicados" Command="{Binding SearchDuplicatesCommand}" />
                    <TextBlock Style="{StaticResource StatusLabel}"
                               Text="Agrupa jogos locais de mesmo nome e verifica save em cada cópia." />
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="3" Style="{StaticResource ThemedDataGrid}"
                  ItemsSource="{Binding DuplicatasView}"
                  SelectionMode="Single" CanUserResizeColumns="True" CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Apagar" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Save" Width="160" SortMemberPath="SaveStatus">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding SaveStatus}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding SaveStatus, Converter={StaticResource StatusBrush}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Pasta de instalação" Width="*" MinWidth="260" SortMemberPath="InstallDir">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding InstallDir}" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallDir}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Situação" Width="140" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
            <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Margin="0"
                    Content="Enviar selecionados para a Lixeira" Command="{Binding RemoveDuplicatesCommand}" />
        </Border>
    </Grid>
</UserControl>
