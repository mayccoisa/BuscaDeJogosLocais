<UserControl x:Class="BuscaDeJogosLocais.Ui.PastasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!--
        A tabela desta página é a que já sumiu uma vez: ela dividia a aba com quatro blocos de
        configuração, os blocos cresceram e a linha "*" dela virou zero pixel. As opções foram
        para a aba Ajustes e aqui a tabela ocupa a página inteira, com altura mínima própria.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource TitleBar}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Pastas monitoradas" />
                <TextBlock Style="{StaticResource PageDescription}"
                           Text="As pastas de onde os jogos saem. Cada linha mostra quanto daquela pasta já virou jogo na biblioteca — e o que ficou de fora." />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                        Content="Adicionar pasta" Command="{Binding AddFolderCommand}" />
                <Button Style="{StaticResource GhostButton}" Margin="0,0,16,0" VerticalAlignment="Center"
                        Content="Atualizar resumo" Command="{Binding AtualizarResumoPastasCommand}" />
                <TextBlock Style="{StaticResource StatusLabel}" MaxWidth="560"
                           Text="Pasta inacessível aqui significa HD desligado ou letra de disco trocada — e faz todos os jogos dela parecerem ausentes até você resolver." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource ThemedDataGrid}"
                  ItemsSource="{Binding PastasResumo}" IsReadOnly="True"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Pasta" Width="*" MinWidth="240" SortMemberPath="Caminho">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Caminho}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Caminho}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Situação" Width="170" SortMemberPath="StatusTexto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding StatusTexto}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding StatusTexto, Converter={StaticResource StatusBrush}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Na biblioteca" Binding="{Binding NaBiblioteca}" Width="105" />
                <DataGridTextColumn Header="Fora" Binding="{Binding NaoImportados}" Width="70" />
                <DataGridTextColumn Header="Com problema" Binding="{Binding ComProblema}" Width="115" />
                <DataGridTextColumn Header="Ignorados" Binding="{Binding Ignorados}" Width="90" />

                <DataGridTemplateColumn Header="" Width="110" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CellButton}" Content="Ver jogos"
                                    Command="{Binding DataContext.VerJogosDaPastaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding PastasResumoTexto}" />
        </Border>
    </Grid>
</UserControl>
