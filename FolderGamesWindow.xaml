<UserControl x:Class="BuscaDeJogosLocais.FolderGamesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuscaDeJogosLocais;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <Grid Margin="20,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TitleBar}" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding HeaderText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageDescription}" Margin="18,8,0,0" Text="{Binding ResumoText}" />
            </StackPanel>

            <CheckBox Grid.Row="1" Margin="0,0,0,10"
                      Content="Mostrar só o que ficou de fora" IsChecked="{Binding SomenteForaDaBiblioteca}" />

            <DataGrid Grid.Row="2" Style="{StaticResource ThemedDataGrid}"
                      ItemsSource="{Binding ItensView}" IsReadOnly="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- Só o jogo com pasta ausente ganha caixa: é o único que tem ação aqui. -->
                    <DataGridTemplateColumn Width="40" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding PodeSelecionar, Converter={StaticResource BoolToVisible}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Jogo" Binding="{Binding Nome}" Width="*" />
                    <DataGridTextColumn Header="Versão" Binding="{Binding Versao}" Width="110" />

                    <DataGridTemplateColumn Header="Situação" Width="150" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Pasta" Width="220" SortMemberPath="NomePasta">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PathText}" Text="{Binding NomePasta}" ToolTip="{Binding Caminho}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- O motivo e a saída. "Não importado" sozinho escondia quatro situações
                         diferentes, e a pessoa não tinha como saber qual era a dela. -->
                    <DataGridTemplateColumn Header="Por quê / o que fazer" Width="1.4*" MinWidth="260" SortMemberPath="Motivo">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Motivo}"
                                               TextWrapping="Wrap" ToolTip="{Binding Motivo}" />
                                    <Button Style="{StaticResource CellButton}" Margin="0,6,0,0"
                                            Content="{Binding AcaoTexto}" Click="OnAcaoClick"
                                            Visibility="{Binding TemAcao, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource ActionBar}" Margin="-20,14,-20,0">
                <DockPanel LastChildFill="False">
                    <!-- O atalho para o Explorador. Some quando esta tela é construída sem o
                         plugin, que é quem sabe avisar caso a pasta não abra. -->
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Margin="0"
                            Content="Abrir pasta no Explorador" Click="OnAbrirPastaClick"
                            Visibility="{Binding PodeAbrirPasta, Converter={StaticResource BoolToVisible}}" />
                    <!-- Relatório em texto de tudo o que esta janela sabe, para colar num chat
                         ou num issue. É o que separa "não funcionou" de um problema com endereço. -->
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Content="Copiar diagnóstico" Click="OnCopiarDiagnosticoClick"
                            ToolTip="Copia um relatório com cada pasta, a situação, o motivo e a ação sugerida." />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0"
                            Content="Fechar" Click="OnFecharClick" />

                    <!-- Ação sobre os jogos cuja pasta sumiu. Antes esta janela só mostrava o
                         "Pasta ausente" e mandava a pessoa procurar a aba "Jogos que sumiram";
                         jogo apagado de propósito não precisa de busca, precisa de decisão. -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0"
                                Visibility="{Binding PodeAgirSobreAusentes, Converter={StaticResource BoolToVisible}}">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Content="Marcar como desinstalado" Click="OnMarcarDesinstaladoClick"
                                ToolTip="Mantém o jogo na biblioteca, como desinstalado. Aparece em Histórico › Desinstalações, de onde dá para reinstalar." />
                        <Button Style="{StaticResource DangerButton}" Margin="0"
                                Content="Remover da biblioteca" Click="OnRemoverClick"
                                ToolTip="Apaga o jogo da biblioteca do Playnite. Não mexe em nada no disco." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
