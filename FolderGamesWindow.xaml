<UserControl x:Class="BuscaDeJogosLocais.FolderGamesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BuscaDeJogosLocais"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding HeaderText}" FontSize="14" FontWeight="Bold" Foreground="Gold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ResumoText}" FontStyle="Italic" Opacity="0.7" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="Mostrar só o que ficou de fora" IsChecked="{Binding SomenteForaDaBiblioteca}"
                      VerticalContentAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ItensView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="#22FFFFFF"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#11FFFFFF"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#22FFFFFF"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Jogo" Binding="{Binding Nome}" Width="*" />
                <DataGridTextColumn Header="Versão" Binding="{Binding Versao}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Na biblioteca">
                                    <Setter Property="Foreground" Value="LightGreen" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Não importado">
                                    <Setter Property="Foreground" Value="Gold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Pasta ausente">
                                    <Setter Property="Foreground" Value="#FF8080" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Ignorado">
                                    <Setter Property="Foreground" Value="#888888" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Pasta" Binding="{Binding NomePasta}" Width="260">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="ToolTip" Value="{Binding Caminho}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fechar" Click="OnFecharClick" Padding="15,7" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
